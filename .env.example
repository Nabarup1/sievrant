# Sievrant Environment Variables
# Copy this file to .env and fill in your actual values

# LLM Provider API Keys
# At least one provider is required for the generation stage
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here
DEEPSEEK_API_KEY=your-deepseek-key-here

# LLM Configuration
# Which provider and model to use by default
SIEVRANT_DEFAULT_LLM_PROVIDER=openai
SIEVRANT_DEFAULT_LLM_MODEL=gpt-4o
SIEVRANT_LLM_TEMPERATURE=0.0
SIEVRANT_LLM_MAX_TOKENS=2048

# Qdrant Vector Database
# Used for the vector index layer
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=sievrant_

# Embedding Model
# Used for query and document embeddings
SIEVRANT_EMBEDDING_PROVIDER=openai
SIEVRANT_EMBEDDING_MODEL=text-embedding-3-small
SIEVRANT_EMBEDDING_DIMENSION=1536

# Cross Encoder Reranker
# Can be local ONNX model or API based
SIEVRANT_RERANKER_TYPE=onnx
SIEVRANT_RERANKER_MODEL_PATH=models/bge-reranker-v2-m3.onnx
# Alternative: API based reranking
# SIEVRANT_RERANKER_TYPE=cohere
# COHERE_API_KEY=your-cohere-key-here

# Retrieval Defaults
SIEVRANT_DEFAULT_COVERAGE=0.95
SIEVRANT_DEFAULT_TOKEN_BUDGET=4000
SIEVRANT_RRF_K=60
SIEVRANT_RERANK_TOP_N=100

# Semantic Cache
SIEVRANT_CACHE_ENABLED=true
SIEVRANT_CACHE_SIMILARITY_THRESHOLD=0.97
SIEVRANT_CACHE_MAX_ENTRIES=100000
SIEVRANT_CACHE_TTL_SECONDS=3600

# Storage
SIEVRANT_DATA_DIR=./data
SIEVRANT_WAL_DIR=./data/wal
SIEVRANT_FLUSH_INTERVAL_SECONDS=30
SIEVRANT_BUFFER_MAX_CHUNKS=10000

# Server Configuration
SIEVRANT_SERVER_HOST=0.0.0.0
SIEVRANT_SERVER_PORT=8080
SIEVRANT_MCP_PORT=8081

# Observability
SIEVRANT_OTEL_ENABLED=true
SIEVRANT_OTEL_ENDPOINT=http://localhost:4317
SIEVRANT_LOG_LEVEL=info
SIEVRANT_LOG_FORMAT=json

# Audit Trail
SIEVRANT_AUDIT_ENABLED=true
SIEVRANT_AUDIT_DIR=./data/audit
SIEVRANT_AUDIT_CHECKSUM_INTERVAL_SECONDS=3600

# Calibration
SIEVRANT_CALIBRATION_DIR=./data/calibration
SIEVRANT_COVERAGE_DRIFT_TOLERANCE=0.02
SIEVRANT_COVERAGE_WINDOW_DAYS=30

# Adaptive Routing
SIEVRANT_ROUTING_ENABLED=true
SIEVRANT_ROUTING_DEFAULT=standard
