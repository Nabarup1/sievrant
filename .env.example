# Sievrant server configuration. Copy to .env and fill in what you need.
# Every name below is read by crates/sievrant-core/src/config.rs.
# Anything left unset falls back to a safe default.

# ---------------------------------------------------------------- API auth (required)
# The server refuses to start without at least one key.
# Generate keys with:  openssl rand -hex 32
# Multi-tenant: comma-separated tenant:key pairs. Each tenant only sees its own corpora.
SIEVRANT_API_KEYS=
# Or a single key for the "default" tenant:
# SIEVRANT_API_KEY=
# Or store only SHA-256 hashes (echo -n "$KEY" | sha256sum):
# SIEVRANT_API_KEY_HASHES=tenant_a:<64 hex chars>
# Local development only, never in production:
# SIEVRANT_AUTH_DISABLED=true

# ---------------------------------------------------------------- server
SIEVRANT_HOST=0.0.0.0
SIEVRANT_PORT=8080
SIEVRANT_GRPC_ENABLED=false
SIEVRANT_GRPC_PORT=50051
# Comma-separated browser origins allowed by CORS. Unset = no browser access.
# SIEVRANT_CORS_ORIGINS=https://app.example.com
SIEVRANT_MAX_BODY_BYTES=33554432
SIEVRANT_MAX_CONCURRENT_REQUESTS=256
SIEVRANT_DATA_DIR=./data

# ---------------------------------------------------------------- LLM (optional)
# "auto" picks the first provider whose key is present; "none" = evidence only.
SIEVRANT_LLM_PROVIDER=auto
# SIEVRANT_LLM_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ---------------------------------------------------------------- embeddings
# "auto" uses a provider whose key is present, else the offline "local" hashing
# embedder (fine for testing, not for production retrieval quality).
SIEVRANT_EMBEDDING_PROVIDER=auto
# SIEVRANT_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------- reranker
# auto | cohere | voyage | jina | custom | embedding | llm | none
SIEVRANT_RERANKER_PROVIDER=auto
# COHERE_API_KEY=

# ---------------------------------------------------------------- vector store
# memory (persisted to SIEVRANT_DATA_DIR) | qdrant
SIEVRANT_VECTOR_BACKEND=memory
# Qdrant's gRPC port is 6334.
QDRANT_URL=http://localhost:6334
# QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=sievrant_

# ---------------------------------------------------------------- retrieval / calibration
SIEVRANT_DEFAULT_COVERAGE=0.95
SIEVRANT_TOKEN_BUDGET=4000
# LLM-written query rewrites before search (costs one fast-LLM call per query).
SIEVRANT_QUERY_EXPANSION=false
# Tree + graph indexes (experimental).
SIEVRANT_EXPERIMENTAL_INDEXES=false
SIEVRANT_COVERAGE_DRIFT_TOLERANCE=0.02

# ---------------------------------------------------------------- audit / receipts
SIEVRANT_AUDIT_ENABLED=true
# Ed25519 key for signed retrieval receipts (optional).
# SIEVRANT_SIGNING_KEY=

# ---------------------------------------------------------------- logging
SIEVRANT_LOG_FORMAT=json
RUST_LOG=info,tower_http=warn

# ---------------------------------------------------------------- SDK clients
# The Python and Node SDKs read these. SIEVRANT_API_KEY is the same variable the
# server accepts for the "default" tenant, so one .env can serve both locally.
# SIEVRANT_BASE_URL=http://localhost:8080
