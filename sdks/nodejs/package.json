{
  "name": "sievrant",
  "version": "0.1.0",
  "description": "TypeScript SDK for Sievrant — the statistically audited retrieval decision engine",
  "keywords": [
    "rag",
    "retrieval",
    "ai",
    "llm",
    "conformal-prediction",
    "langchain",
    "enterprise",
    "vector-search",
    "typescript"
  ],
  "author": "Sievrant Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Nabarup1/sievrant",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nabarup1/sievrant.git",
    "directory": "sdks/nodejs"
  },
  "bugs": {
    "url": "https://github.com/Nabarup1/sievrant/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./integrations/langchain": {
      "import": "./dist/integrations/langchain.js",
      "require": "./dist/integrations/langchain.cjs",
      "types": "./dist/integrations/langchain.d.ts"
    },
    "./integrations/vercel-ai": {
      "import": "./dist/integrations/vercel-ai.js",
      "require": "./dist/integrations/vercel-ai.cjs",
      "types": "./dist/integrations/vercel-ai.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:native": "napi build --platform --release --manifest-path ../../crates/sievrant-node/Cargo.toml -o src",
    "build": "npm run build:native && tsup src/index.ts src/integrations/langchain.ts src/integrations/vercel-ai.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "napi": {
    "name": "sievrant-node",
    "triples": {
      "defaults": true,
      "additional": []
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.6",
    "@types/node": "^26.5.1",
    "msw": "^2.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.2.0",
    "ai": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
